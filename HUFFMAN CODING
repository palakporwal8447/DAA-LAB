#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Node {
    char data;
    int freq;
    struct Node *left, *right;
};

// Create a new node
struct Node* newNode(char data, int freq) {
    struct Node* temp = (struct Node*)malloc(sizeof(struct Node));

    temp->data = data;
    temp->freq = freq;
    temp->left = temp->right = NULL;

    return temp;
}

// Swap two node pointers
void swap(struct Node** a, struct Node** b) {
    struct Node* temp = *a;
    *a = *b;
    *b = temp;
}

// Min Heapify
void minHeapify(struct Node* heap[], int n, int i) {
    int smallest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && heap[left]->freq < heap[smallest]->freq)
        smallest = left;

    if (right < n && heap[right]->freq < heap[smallest]->freq)
        smallest = right;

    if (smallest != i) {
        swap(&heap[i], &heap[smallest]);
        minHeapify(heap, n, smallest);
    }
}

// Build Min Heap
void buildMinHeap(struct Node* heap[], int n) {
    for (int i = n / 2 - 1; i >= 0; i--)
        minHeapify(heap, n, i);
}

// Extract minimum frequency node
struct Node* extractMin(struct Node* heap[], int* n) {
    struct Node* temp = heap[0];

    heap[0] = heap[*n - 1];
    (*n)--;

    minHeapify(heap, *n, 0);

    return temp;
}

// Insert node into Min Heap
void insertHeap(struct Node* heap[], int* n, struct Node* node) {
    int i = *n;
    heap[i] = node;
    (*n)++;

    while (i > 0 && heap[(i - 1) / 2]->freq > heap[i]->freq) {
        swap(&heap[i], &heap[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

// Print Huffman Codes
void printCodes(struct Node* root, int code[], int top) {
    if (root->left) {
        code[top] = 0;
        printCodes(root->left, code, top + 1);
    }

    if (root->right) {
        code[top] = 1;
        printCodes(root->right, code, top + 1);
    }

    // Leaf node
    if (!root->left && !root->right) {
        printf("%c : ", root->data);

        for (int i = 0; i < top; i++)
            printf("%d", code[i]);

        printf("\n");
    }
}

// Huffman Algorithm
void huffman(char data[], int freq[], int n) {
    struct Node* heap[100];

    for (int i = 0; i < n; i++)
        heap[i] = newNode(data[i], freq[i]);

    int heapSize = n;

    buildMinHeap(heap, heapSize);

    while (heapSize > 1) {

        struct Node* left = extractMin(heap, &heapSize);
        struct Node* right = extractMin(heap, &heapSize);

        struct Node* parent =
            newNode('$', left->freq + right->freq);

        parent->left = left;
        parent->right = right;

        insertHeap(heap, &heapSize, parent);
    }

    int code[100];

    printf("Huffman Codes:\n");
    printCodes(heap[0], code, 0);
}

int main() {

    char data[] = {'A', 'B', 'C', 'D', 'E', 'F'};
    int freq[] = {5, 9, 12, 13, 16, 45};

    int n = sizeof(data) / sizeof(data[0]);

    huffman(data, freq, n);

    return 0;
}
